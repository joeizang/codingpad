<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="NuGet.Commands" Version="7.9.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <ProjectReference Include="../../runtimes/dotnet/CodingPad/CodingPad.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildSDKsPath)/../PortableRuntimeIdentifierGraph.json" Link="PortableRuntimeIdentifierGraph.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
