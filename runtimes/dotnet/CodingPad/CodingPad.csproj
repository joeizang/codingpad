<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>CodingPad</PackageId>
    <Version>0.1.0</Version>
    <Description>CodingPad script helpers for hosted and standalone C# scripts.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- API organization only: this unsigned friend name does not authenticate callers. -->
    <InternalsVisibleTo Include="CodingPad.Kernel" />
    <None Include="build/CodingPad.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>
</Project>
