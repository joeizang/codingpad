<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>CodingPad</PackageId>
    <Version>0.1.0</Version>
    <Description>CodingPad script helpers for hosted and standalone C# scripts.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodingPad.Kernel" />
    <None Include="build/CodingPad.props" Pack="true" PackagePath="build/" />
  </ItemGroup>
</Project>
